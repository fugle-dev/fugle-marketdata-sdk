<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net6.0;net8.0</TargetFrameworks>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- NuGet package ID is permanent once published. Namespaces are unchanged
         (`FugleMarketData` wrapper, `MarketdataUniffi` raw bindings), so existing
         `using` directives keep compiling. -->
    <PackageId>Fugle.MarketData</PackageId>
    <Version>0.1.0-rc.1</Version>
    <Authors>Fugle Team</Authors>
    <Title>Fugle Market Data SDK</Title>
    <Description>Fugle market data REST and WebSocket client for .NET, backed by the Rust core via UniFFI.</Description>
    <PackageTags>fugle;marketdata;taiwan;stock;futures;options;websocket</PackageTags>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://developer.fugle.tw</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/fugle-dev/fugle-marketdata-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- IsExternalInit polyfill for records in netstandard2.0/net6.0 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' or '$(TargetFramework)' == 'net6.0'">
    <Compile Include="../Polyfills/IsExternalInit.cs" Link="Polyfills/IsExternalInit.cs" />
  </ItemGroup>

  <!-- Include native library at runtime - supports both local dev and CI builds -->
  <!-- CI build: native libraries copied to runtimes/ directory -->
  <ItemGroup Condition="Exists('runtimes/linux-x64/native/libmarketdata_uniffi.so')">
    <None Include="runtimes/**/*" Pack="true" PackagePath="runtimes/" />
  </ItemGroup>

  <!-- Local dev: native libraries from target/release/ (for development only) -->
  <ItemGroup Condition="!Exists('runtimes/linux-x64/native/libmarketdata_uniffi.so')">
    <None Include="../../../target/release/libmarketdata_uniffi.dylib"
          Pack="true"
          PackagePath="runtimes/osx-arm64/native/"
          Condition="Exists('../../../target/release/libmarketdata_uniffi.dylib')" />
    <None Include="../../../target/release/libmarketdata_uniffi.so"
          Pack="true"
          PackagePath="runtimes/linux-x64/native/"
          Condition="Exists('../../../target/release/libmarketdata_uniffi.so')" />
    <None Include="../../../target/release/marketdata_uniffi.dll"
          Pack="true"
          PackagePath="runtimes/win-x64/native/"
          Condition="Exists('../../../target/release/marketdata_uniffi.dll')" />
  </ItemGroup>

</Project>
