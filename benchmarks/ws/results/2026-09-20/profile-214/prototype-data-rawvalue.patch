diff --git a/core/src/websocket/protocol.rs b/core/src/websocket/protocol.rs
index bdff024..8d3dc2f 100644
--- a/core/src/websocket/protocol.rs
+++ b/core/src/websocket/protocol.rs
@@ -253,9 +253,43 @@ pub(crate) fn frame_request(req: &WebSocketRequest) -> Result<String, MarketData
 
 /// Parse an inbound text frame into a typed `WebSocketMessage`.
 pub(crate) fn parse_text_frame(text: &str) -> Result<WebSocketMessage, MarketDataError> {
+    // PROTOTYPE (#214 measurement only): for data events, keep `data` as the
+    // verbatim slice instead of a `serde_json::Value` tree.
+    if text.starts_with("{\"event\":\"data\"") {
+        #[derive(serde::Deserialize)]
+        struct Light {
+            event: String,
+            #[serde(default)]
+            channel: Option<String>,
+            #[serde(default)]
+            symbol: Option<String>,
+            #[serde(default)]
+            id: Option<String>,
+            #[serde(default)]
+            code: Option<i32>,
+            #[serde(default)]
+            message: Option<String>,
+            #[serde(default)]
+            data: Option<Box<serde_json::value::RawValue>>,
+        }
+        let l: Light =
+            serde_json::from_str(text).map_err(|e| MarketDataError::DeserializationError { source: e })?;
+        return Ok(WebSocketMessage {
+            event: l.event,
+            data: None,
+            data_raw: l.data.map(|d| d.get().to_string()),
+            channel: l.channel,
+            symbol: l.symbol,
+            id: l.id,
+            code: l.code,
+            message: l.message,
+            raw: text.to_string(),
+        });
+    }
     let mut msg: WebSocketMessage =
         serde_json::from_str(text).map_err(|e| MarketDataError::DeserializationError { source: e })?;
     msg.raw = text.to_string();
+    msg.data_raw = None;
     Ok(msg)
 }
 
